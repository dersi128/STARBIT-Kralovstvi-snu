[ext_resource type="Texture2D" path="res://assets/worldkit/Lantern.tres" id="1"]

[sub_resource type="Shader" id="Shader_lantern_cutout"]
code = "shader_type canvas_item;

void fragment() {
	// Atlas UVs: keep the whole lantern and its leaves, hide adjacent sprites.
	vec2 pixel = UV / TEXTURE_PIXEL_SIZE;
	bool side_fragment = pixel.x < 1065.0 || pixel.x > 1210.0;
	bool neighboring_star = pixel.x > 1145.0 && pixel.y > 890.0;
	if (side_fragment || neighboring_star) {
		COLOR.a = 0.0;
	}
}
"

